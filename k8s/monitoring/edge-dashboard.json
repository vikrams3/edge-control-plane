{
  "uid": "edge-control-plane",
  "title": "Edge control plane",
  "tags": [
    "edge"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/s by Envoy group",
      "description": "Users hit the edge Service, so the canary carries about a third of traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (group) (rate(envoy_http_downstream_rq_completed{envoy_http_conn_manager_prefix=\"edge\"}[1m]))",
          "legendFormat": "{{group}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "5xx ratio by Envoy group",
      "description": "Alert EdgeHigh5xxRate fires above 5% for 1 minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (group) (rate(envoy_http_downstream_rq_xx{envoy_http_conn_manager_prefix=\"edge\",envoy_response_code_class=\"5\"}[1m])) / sum by (group) (rate(envoy_http_downstream_rq_completed{envoy_http_conn_manager_prefix=\"edge\"}[1m]))",
          "legendFormat": "{{group}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "p99 latency by Envoy group",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (group, le) (rate(envoy_http_downstream_rq_time_bucket{envoy_http_conn_manager_prefix=\"edge\"}[1m])))",
          "legendFormat": "{{group}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Requests/s by backend and status class",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_cluster_name, envoy_response_code_class) (rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name!=\"xds_cluster\"}[1m]))",
          "legendFormat": "{{envoy_cluster_name}} {{envoy_response_code_class}}xx"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "p99 latency by backend",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (envoy_cluster_name, le) (rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name!=\"xds_cluster\"}[1m])))",
          "legendFormat": "{{envoy_cluster_name}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Rollouts (last 5 min) by outcome",
      "description": "From the control plane's Micrometer counter edge_rollouts_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(edge_rollouts_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Envoys connected to the control plane",
      "description": "Envoys keep serving their last config when this drops to zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "edge_envoys_connected",
          "legendFormat": "{{group}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "xDS config version",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "edge_config_version",
          "legendFormat": "version"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Rollout duration p50 by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (outcome, le) (rate(edge_rollout_duration_seconds_bucket[10m]))) or (sum by (outcome) (rate(edge_rollout_duration_seconds_sum[10m])) / sum by (outcome) (rate(edge_rollout_duration_seconds_count[10m])))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 9
    }
  ]
}
